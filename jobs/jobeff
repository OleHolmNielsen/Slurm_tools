#!/bin/bash

# Show the CPU, memory and GPU efficiency of a running or finished Slurm job.
# This script uses Bash and the Slurm "sacct" and "sstat" tools to provide
# output similar to the "seff" tool from the slurm-contribs RPM package.
# For a running job, the steps still running are read with "sstat".
# Exit codes: 0 OK, 1 usage, 2 job not found, 4 job is not running or ended.
#
# Author: Ole Holm Nielsen <Ole.H.Nielsen@fysik.dtu.dk>
# Homepage: https://github.com/OleHolmNielsen/Slurm_tools/tree/master/jobs

function usage() {
	echo "Usage: jobeff [Options] <Jobid>"
	echo "       Options:"
	echo "       -h    Help menu"
	echo "       -d    Debug mode: display raw Slurm data"
	exit 1
}

debug=0
while getopts "hd" opt
do
	case $opt in
		d) debug=1 ;;
		*) usage ;;
	esac
done
shift $((OPTIND - 1))
[ $# -ne 1 ] && usage
jobid=$1

### Helpers

# Print the values of KEY in TRES strings ("cpu=4,mem=40000M,node=1") read from stdin.
function tres() { grep -oE "(^|,)$1=[^,]*" | cut -d= -f2-; }

# Lowest and highest of a list of sizes such as 1500, 900M, 2G (n/a if empty).
function lowest() { sort -h | head -1 | grep . || echo n/a; }
function highest() { sort -h | tail -1 | grep . || echo n/a; }

# Evaluate a floating point expression: calc FORMAT EXPRESSION
function calc() { awk "BEGIN { printf \"$1\", $2 }"; }

# Convert a memory size such as 40000M (or plain bytes) to bytes.
function to_bytes() {
	local value=${1:-0}
	case $value in
		*K) echo $(( ${value%K} * 1024 )) ;;
		*M) echo $(( ${value%M} * 1024**2 )) ;;
		*G) echo $(( ${value%G} * 1024**3 )) ;;
		*T) echo $(( ${value%T} * 1024**4 )) ;;
		*)  echo "$value" ;;
	esac
}

# Format bytes as e.g. "361.20 MB".
function bytes2str() {
	awk -v b="$1" 'BEGIN {
		if (b <= 0) { print "0.00 MB"; exit }
		split("B KB MB GB TB PB", unit, " ")
		e = int(log(b) / log(1024)); if (e > 5) e = 5
		printf "%.2f %s", b / 1024^e, unit[e + 1]
	}'
}

# Format an energy in Joules as e.g. "2.87 kJ" (in awk, as Slurm may give values too large for Bash integers).
function joule2str() {
	awk -v j="$1" 'BEGIN {
		if (j < 1000) { printf "%d J", j; exit }
		split("J kJ MJ GJ TJ PJ EJ", unit, " ")
		for (e = 0; j >= 999.995 && e < 6; e++) j /= 1000	# 999.995 would round up to 1000.00
		printf "%.2f %s", j, unit[e + 1]
	}'
}

# Convert a sacct time ([D-][HH:]MM:SS[.mmm]) to whole seconds, rounded.
function time2sec() {
	awk -v t="$1" 'BEGIN {
		if (split(t, a, "-") == 2) { days = a[1]; t = a[2] }
		n = split(t, p, ":")
		for (i = 1; i <= n; i++) s = s * 60 + p[i]
		printf "%d", days * 86400 + s + 0.5
	}'
}

# Width of the label column in the report.
label_width=19
# Energy values (Joules) above this are assumed to be errors: due to former Slurm bugs the
# value may be astronomically large (such as 18446744073709551614, Slurm's NO_VAL64).
max_energy=10000000000		# 10 GJ = 2778 kWh
# The SlurmUser of slurm.conf (sacct shows all jobs to root and SlurmUser).
slurm_user=slurm
# Warn about inefficient GPU usage when the max or average GPU utilization (%) is below this value.
gpu_util_threshold=10

# Print a report line with the label and the value(s) in aligned columns: field LABEL VALUE...
# An empty LABEL prints a continuation line of the previous value.
function field() {
	local label=${1:+$1:}
	shift
	printf "%-${label_width}s %s\n" "$label" "$*"
}

# Format seconds as [D-]HH:MM:SS.
function time2str() {
	local t=$1 days=$(($1 / 86400))
	[ $days -ge 1 ] && printf "%d-" $days
	printf "%02d:%02d:%02d" $((t % 86400 / 3600)) $((t % 3600 / 60)) $((t % 60))
}

### Job data

# Note: SLUID (Slurm Lexicographically-sortable Unique ID) parameter was added in Slurm 24.11,
#   see https://slurm.schedmd.com/squeue.html#OPT_Sluid
# The job line is the first one without a ".step" suffix. (Not using sacct -X,
# as TotalCPU then no longer includes the CPU time of the steps.)
job_fields=JobID,JobIDRaw,SLUID,User,Group,State,Cluster,Partition,NodeList,AllocCPUS,AllocNodes,AllocTRES,TotalCPU,ElapsedRaw,ExitCode,Submit,Start,End,ConsumedEnergyRaw,Exclusive
# sacct fails (non-zero exit status, error message on stderr) when the Slurm database is not responding.
# The times are printed in the standard format YYYY-MM-DDTHH:MM:SS, which is also used in sacct queries below.
export SLURM_TIME_FORMAT=standard
# The usage data of the job steps (step_fields) are read in the same sacct call,
# after the job fields, to minimize the number of calls to the Slurm database.
step_fields=JobID,TRESUsageInTot,TRESUsageInMax,TRESUsageInAve
sacct_data=$(sacct -P -n --noconvert -j "$jobid" -o $job_fields,${step_fields#JobID,} 2>&1)
status=$?
if [ $status -ne 0 ]
then
	echo "sacct failed (exit status $status):" >&2
	echo "$sacct_data" >&2
	exit 2
fi
# Keep only the parsable lines (skipping any warnings from sacct).
sacct_data=$(awk -F'|' 'NF > 1' <<< "$sacct_data")
job=$(awk -F'|' '$1 !~ /\./' <<< "$sacct_data" | head -1)
if [ -z "$job" ]
then
	echo "Job not found." >&2
	exit 2
fi
IFS='|' read -r id raw_id sluid user group state cluster partition nodelist ncpus nnodes alloc totalcpu walltime exitcode submit start end energy exclusive _ <<< "$job"
state=${state%% *}			# "CANCELLED by 123" -> "CANCELLED"

# Statistics are available for running jobs (so far) and for jobs that have ended.
running=0
case $state in
	RUNNING) running=1 ;;
	COMPLETED|FAILED|CANCELLED|TIMEOUT|OUT_OF_MEMORY|NODE_FAIL|BOOT_FAIL|DEADLINE|PREEMPTED) ;;
	*) echo "Job $jobid is in state $state: efficiency statistics are only available once the job is running." >&2
	   exit 4 ;;
esac
[ "${ncpus:-0}" -eq 0 ] && ncpus=1
[ "${nnodes:-0}" -eq 0 ] && nnodes=1

# Usage data of the job steps: step_usage [--noconvert] -o FIELDS
# sacct has the data of steps that have ended. For a running job, sstat adds the
# steps still running (sstat lists them by the raw job ID, also for array jobs).
function step_usage() {
	sacct -P -n -j "$jobid" "$@" 2>/dev/null
	[ $running -eq 1 ] && sstat -P -n -a -j "$raw_id" "$@" 2>/dev/null
}

# The step fields from sacct: JobID and the last fields after the job fields.
steps=$(awk -F'|' -v OFS='|' -v n=$(( $(tr -cd , <<< "$job_fields" | wc -c) + 1 )) '{ print $1, $(n+1), $(n+2), $(n+3) }' <<< "$sacct_data")
# For a running job, sstat also gives the energy consumed so far by the running steps
# (ConsumedEnergyRaw, in Joules), as sacct has the energy only when the job has ended.
# The steps overlap in time (the extern step spans the whole job), so take the largest value.
# Invalid values above max_energy (see above) are skipped.
running_steps=""
if [ $running -eq 1 ]
then
	running_steps=$(sstat -P -n -a --noconvert -j "$raw_id" -o $step_fields,ConsumedEnergyRaw 2>/dev/null)
	energy=$(awk -F'|' -v e="${energy:-0}" -v max=$max_energy '$5 > e && $5 <= max { e = $5 } END { printf "%.0f", e }' <<< "$running_steps")
	running_steps=$(cut -s -d'|' -f1-4 <<< "$running_steps")
fi
[ -n "$running_steps" ] && steps+=$'\n'"$running_steps"

if [ $debug -eq 1 ]
then
	echo "Slurm data ($job_fields):"
	echo "$job"
	echo "Slurm step data ($step_fields):"
	echo "$steps"
	echo
fi

### Report

heading="Efficiency report for Slurm job $id"
echo "$heading"
echo "${heading//?/=}"	# Underline of the same length
echo
printf "%-${label_width}s %s\n" "Parameter" "Value" "---------" "-----"	# Column headings, aligned as in field()
field "Job ID" "$raw_id"
[[ $id == *_* ]] && field "Array Job ID" "$id"
field "Job SLUID" "$sluid"
field "Cluster" "$cluster"
field "Partition" "$partition"
field "NodeList" "$nodelist"
field "User/Group" "$user/$group"
if [ $running -eq 1 ]
then
	field "State" "$state (statistics so far)"
else
	field "State" "$state (exit code ${exitcode%%:*})"	 # ExitCode is "exit:signal"
fi
field "Submit time" "$submit"
field "Start time" "$start"
field "Elapsed time" "$(time2str $walltime)"
field "End time" "$end"
if [ $ncpus -eq 1 ]
then
	field "Cores" "1"
else
	field "Nodes" "$nnodes"
	field "Cores per node" "$((ncpus / nnodes))"
fi

# CPU: TotalCPU of the job is the sum over all its steps that have ended.
# Add the CPU time of the steps still running, from sstat (the cpu entry of TRESUsageInTot).
cputime=$(time2sec "${totalcpu:-0}")
for t in $(cut -s -d'|' -f2 <<< "$running_steps" | tres cpu); do
	cputime=$((cputime + $(time2sec "$t")))
done
corewalltime=$((walltime * ncpus))
field "CPU Utilized" "$(time2str $cputime)"
field "CPU Efficiency" "$(calc %.2f "$corewalltime ? $cputime / $corewalltime * 100 : 0")% of $(time2str $corewalltime) core-walltime"

# Memory used: TRESUsageInTot mem is the sum of the memory peaks of all tasks of a step.
# Take the step with the largest sum, and the max and average task peak of that step.
used=0 task_max=0 task_ave=0
while IFS='|' read -r step tot max ave; do
	tot=$(tres mem <<< "$tot")
	if [[ $step == "$id".* || $step == "$raw_id".* ]] && (( ${tot:-0} > used ))
	then
		used=$tot
		task_max=$(tres mem <<< "$max")
		task_ave=$(tres mem <<< "$ave")
	fi
done <<< "$steps"
field "Memory Utilized" "$(bytes2str $used)"

# Memory allocated, per core or per node. sacct's parsable output does not tell which
# was requested, but the JSON output does (needs jq; otherwise assume per node).
allocated=$(to_bytes "$(tres mem <<< "$alloc")")
per=node divisor=$nnodes
if command -v jq > /dev/null &&
	[ "$(sacct --json -j "$jobid" 2>/dev/null |
	jq --argjson id "$raw_id" '[.jobs[] | select(.job_id == $id)][0].required.memory_per_cpu.set')" = true ]
then
	per=core divisor=$ncpus
fi
field "Memory Efficiency" "$(calc %.2f "$allocated ? $used / $allocated * 100 : 0")% of $(bytes2str $allocated) ($(bytes2str $((allocated / divisor)))/$per)"
if (( ${task_ave:-0} > 0 && ${task_max:-0} > task_ave ))
then
	field "Please note" "The task which had the largest memory consumption"
	field "" "differs by $(calc %.2f "$task_max / $task_ave * 100")% from the average task max memory consumption"
fi

# GPUs, if any were allocated. Over all steps: the lowest task minimum,
# the highest task maximum, and the highest step average.
if [[ $alloc == *gres/gpu* ]]
then
	usage=$(step_usage -o TRESUsageInMin,TRESUsageInMax,TRESUsageInAve)
	min=$(cut -d'|' -f1 <<< "$usage") max=$(cut -d'|' -f2 <<< "$usage") ave=$(cut -d'|' -f3 <<< "$usage")
	gpus="gres/gpu=$(tres gres/gpu <<< "$alloc")"
	field "GPU AllocTRES" "$alloc"
	gpu_max=$(tres gres/gpuutil <<< "$max" | highest)
	gpu_avg=$(tres gres/gpuutil <<< "$ave" | highest)
	field "GPU utilization" "min $(tres gres/gpuutil <<< "$min" | lowest)%," \
		 "max $gpu_max%," \
		 "avg $gpu_avg% ($gpus)"
	# Warn when the max or average GPU utilization is below the threshold (skipped when there is no GPU data)
	if [[ $gpu_max != n/a && $gpu_avg != n/a ]] &&
		awk -v max="$gpu_max" -v avg="$gpu_avg" -v t="$gpu_util_threshold" 'BEGIN { exit !(max < t || avg < t) }'
	then
		field "Warning" "The max or avg GPU utilization is below ${gpu_util_threshold}%:"
		field "" "the job seems not to use the allocated GPUs efficiently"
	fi
	field "GPU memory" "min $(tres gres/gpumem <<< "$min" | lowest)," \
		 "max $(tres gres/gpumem <<< "$max" | highest)," \
		 "avg $(tres gres/gpumem <<< "$ave" | highest) (MB) ($gpus)"
fi

# Energy consumed by the job in Joules (ConsumedEnergyRaw), if measured (1 kWh = 3600000 J).
# Values above max_energy are assumed to be errors. (Compared in awk, as they may overflow Bash integers.)
kwh=$(awk -v e="${energy:-0}" 'BEGIN { kwh = e / 3600000; printf (kwh < 1 ? "%.3g" : kwh > 10 ? "%.0f" : "%.3f"), kwh }')
case $(awk -v e="${energy:-0}" -v max=$max_energy 'BEGIN { print (e > max ? "error" : e > 0 ? "ok" : "none") }') in
	ok)	field "Energy consumed" "$kwh kWh ($(joule2str "$energy"))"
		# Slurm measures the energy of entire nodes. If other jobs ran on the nodes
		# while this job was running (node state Mixed), the energy also includes theirs.
		# Exclusive=NODE (sbatch --exclusive): the job had its nodes to itself.
		# Otherwise look up the other jobs with sacct, using times in the standard (sortable) format.
		if [[ ${exclusive^^} != NODE ]]
		then
			t_end=$end
			[[ $t_end == Unknown || -z $t_end ]] && t_end=$(date +%Y-%m-%dT%H:%M:%S)
			shared=$(sacct -a -n -P -X -s R -N "$nodelist" -S "$start" -E "$t_end" \
				-o JobIDRaw,Start,End 2>/dev/null |
				awk -F'|' -v id="$raw_id" -v s="$start" -v e="$t_end" '$1 != id && ($3 > s || $3 == "Unknown") && $2 < e' | wc -l)
			# Unless run by root or SlurmUser, sacct may only show the user's own jobs (PrivateData
			# in slurmdbd.conf). Then other users' jobs may have shared the nodes without being seen,
			# if this job did not allocate all CPUs of its nodes (scontrol is only called in that case).
			if (( shared > 0 ))
			then
				field "" "Note: This is the energy of the entire nodes, which were shared with $shared other job(s)"
				field "" "(Mixed node state), so it is not the energy of this job alone"
			elif [[ $(id -un) != root && $(id -un) != "$slurm_user" ]] &&
				(( ncpus < $(scontrol show node -o "$nodelist" 2>/dev/null | grep -oE 'CPUTot=[0-9]+' | awk -F= '{ n += $2 } END { print n + 0 }') ))
			then
				field "" "Note: This is the energy of the entire nodes, and it may include other jobs"
				field "" "which shared the nodes (Mixed node state), so it may not be the energy of this job alone"
			fi
		fi ;;
	error)	field "Energy consumed" "n/a (Slurm reported an invalid value of $kwh kWh)" ;;
esac
