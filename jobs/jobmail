#!/bin/bash

# Send a Slurm notification email from slurmctld for jobs that have ended,
# and add a job efficiency report (CPU, memory, and GPU) in the mail body.
# The report is made by the "jobeff" script, which must be installed in /usr/local/bin.
#
# This script must be readable and executable by SlurmUser and is called as:
#   <MailProg> -s "<subject>" <recipient>
# where the <MailProg> parameter is configured in slurm.conf.
# Note that PATH and HOME variables are unset when slurmctld calls MailProg.
#
# Author: Ole Holm Nielsen <Ole.H.Nielsen@fysik.dtu.dk>
# Homepage: https://github.com/OleHolmNielsen/Slurm_tools/tree/master/jobs

MAIL=/bin/mail			# This command must be available on the system
export PATH=/usr/local/bin:/usr/bin:/bin:$PATH	# slurmctld may run with a minimal or empty PATH
unset SLURM_TIME_FORMAT		# Use the Slurm default time format, whatever the caller sets

# Define the time for the job to finish and its accounting data to be committed to slurmdbd.
# Note: `systemctl stop/restart slurmctld` may wait for this sleep to end.
JOB_COMPLETION_TIME=5

### Main: send the mail

subject="$SLURM_CLUSTER_NAME $2"
recipient=$3

# Only end records have an ending state, the 3rd comma-separated part of the subject.
IFS=, read -r _ _ end_state _ <<< "$2"

if [ -n "${end_state// /}" ] && [[ $2 =~ Job_id=([0-9]+(_[0-9]+)?) ]]
then
	# "Job_id=123_4" -> 123_4 (an array task); "Job_id=123_*" -> 123 (the whole array)
	jobid=${BASH_REMATCH[1]}
	if ! command -v jobeff > /dev/null 2>&1
	then
		echo "ERROR: The jobeff command was not found in PATH=$PATH" \
			"on host $(hostname), so no job efficiency report is available for job $jobid." \
			| $MAIL -s "$subject" "$recipient"
		exit 0
	fi
	sleep $JOB_COMPLETION_TIME
	# Errors from jobeff (such as "Job not found") go into the mail body as well.
	jobeff "$jobid" 2>&1 | $MAIL -s "$subject" "$recipient"
else
	$MAIL -s "$subject" "$recipient"
fi
