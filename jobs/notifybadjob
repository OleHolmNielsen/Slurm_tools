#!/usr/bin/env bash

# Notify about or Kill a badly behaving job and send information mail to the user.
# Author: Ole Holm Nielsen, Ole.H.Nielsen@fysik.dtu.dk
# Homepage: https://github.com/OleHolmNielsen/Slurm_tools/

### CONFIGURE these lines:
# Mail to the system managers
ADMINMAIL=support@your.domain
# Mail to the superuser (receives a Bcc copy of every mail)
SUPERUSERMAIL=root@localhost
# Base URL of the user documentation (used in some of the reasons below)
BASEURL=https://your.domain
# Informative web page:
INFOURL=$BASEURL
### End CONFIGURE these lines:

# Location of our Slurm tools (see https://github.com/OleHolmNielsen/Slurm_tools/tree/master/)
PSJOB=/usr/local/bin/psjob
PESTAT=/usr/local/bin/pestat
# Mail program
MAIL=/usr/bin/mailx
# Logfile of killed jobs
LOGFILE=/var/log/notifybadjob.log
# Max. number of files to list from the job's working directory
MAXFILES=20
# Warn the user if the working directory contains at least this many files
MANYFILES=1000

usage() {
	echo "Usage: $0 [-k] jobid [jobid ...]"
	echo "  -k: Kill the job(s) (default is to only notify the user)"
}

#
# Process command arguments
#
killjob=0
while getopts "kh" option; do
	case $option in
		k) killjob=1 ;;
		h) usage; exit 0 ;;
		*) usage; exit 1 ;;
	esac
done
shift $((OPTIND - 1))
if (( $# == 0 )); then
	usage
	exit 1
fi

if (( killjob )); then
	action='Kill'
else
	action='Notify about'
fi

# Name of this cluster
CLUSTERNAME=$(scontrol show config | awk '$1 == "ClusterName" {print $3}')

# Temporary files (removed automatically when the script exits)
TMPDIR_JOB=$(mktemp -d /tmp/notifybadjob.XXXXXX) || exit 1
trap 'rm -rf "$TMPDIR_JOB"' EXIT
trap 'exit 2' HUP INT QUIT TERM
MESSAGE=$TMPDIR_JOB/message
JOBMSGS=$TMPDIR_JOB/jobmsgs
JOBERRS=$TMPDIR_JOB/joberrs

#
# Reasons for notifying/killing a job.
# The numbers are what the operator types, so keep existing numbers stable.
#
declare -A REASONS=(
	[1]="Your job is doing no useful work and is essentially dead."
	[2]="Your job has grossly exceeded the available physical RAM memory and is very inefficient."
	[3]="Your job has grossly exceeded the physical RAM memory available per CPU core."
	[4]="Your job is running too many processes/threads and is overloading the CPU(s)."
	[5]="Your job is using more CPU cores than your job has requested."
	[6]="Your job is not using all of the CPU cores or GPUs that you have requested."
	[7]="Your job is not using all of the GPUs that you have requested."
	[9]="Your job is not laid out correctly for xeon24 multi-CPU nodes - you MUST use the xeon24 partition correctly, see $BASEURL/Niflheim_Getting_Started#correct-usage-of-multi-cpu-nodes"
	[10]="Your job is unfortunately running on a node that has a hardware or electrical error."
	[11]="Error in the input file caused job to fail."
	[12]="Job failed - please examine the output file."
	[13]="SCF convergence problems - please examine the output file."
	[14]="Your job seems to be very inefficient with a low CPU utilization."
	[15]="Your job is doing too heavy I/O on the group shared fileserver."
	[16]="Your job has filled up the compute node local /tmp disk."
	[17]="Your GPAW job has grossly exceeded the available physical RAM memory and is very inefficient. Please test the memory requirement as described at https://wiki.fysik.dtu.dk/gpaw/documentation/parallel_runs/parallel_runs.html"
	[18]="Job failed due to exceeded disk quota - please provide $ADMINMAIL with an estimation of your necessary disk space."
	[19]="Your job requests resources that cannot be satisfied or do not exist."
	[20]="Please ask $ADMINMAIL for the reason."
	[21]="Your MPI job uses 1 Gbit Ethernet in stead of the fast OPA/IB, please correct your MPI command."
	[96]="Your job is not laid out correctly for 4TB big-memory nodes - you MUST use this partition for big-memory jobs only"
	[97]="Your job is not laid out correctly for xeon56 multi-CPU nodes - you MUST use the xeon56 partition correctly."
	[98]="Your job is not laid out correctly for sm3090 GPU nodes - you MUST use the sm3090 partition correctly, see $BASEURL/Niflheim_Getting_Started/#usage-of-gpu-compute-nodes"
	[99]="Your job is not laid out correctly for xeon40 multi-CPU nodes - you MUST use the xeon40 partition correctly, see $BASEURL/Niflheim_Getting_Started#correct-usage-of-multi-cpu-nodes"
)
# The reason numbers in ascending order
mapfile -t REASON_NUMBERS < <(printf '%s\n' "${!REASONS[@]}" | sort -n)

#
# Ask the operator for the reason (one reason applies to all jobs given)
#
action_reason=""
while [[ -z "$action_reason" ]]; do
	echo
	echo "Please select one of the following reasons why you want to $action this job:"
	for n in "${REASON_NUMBERS[@]}"; do
		printf '%3d. %s\n' "$n" "${REASONS[$n]}"
	done
	if ! read -r -p "Please enter reason (no default): " answer; then
		# End of input (e.g. Ctrl-D or stdin is not a terminal)
		echo
		echo "ERROR: No reason was given"
		exit 1
	fi
	# Accept only numbers, and strip leading zeros (so that "01" means 1)
	if [[ $answer =~ ^[0-9]+$ ]]; then
		action_reason=${REASONS[$((10#$answer))]}
	fi
done
echo "Reason: $action_reason"

#
# Print the value of a "Key=Value" field from the scontrol job information.
# Only exact keys match, so "NodeList" does not match "ReqNodeList".
#
job_field() {
	awk -v key="$1=" '{
		for (i = 1; i <= NF; i++)
			if (index($i, key) == 1) { print substr($i, length(key) + 1); exit }
	}' "$JOBMSGS"
}

#
# Write the information about the job's working directory to the message
#
append_workdir_info() {
	local workdir=$1
	local numfiles
	numfiles=$(find "$workdir" -mindepth 1 -maxdepth 1 -printf . 2>/dev/null | wc -c)
	cat <<EOF >> "$MESSAGE"

Information about files in job working directory
------------------------------------------------

Job $jobid working directory $workdir
This directory contains $numfiles files in total.
EOF
	if (( numfiles < MANYFILES )); then
		echo "Newest files in this directory are (max. $MAXFILES files):" >> "$MESSAGE"
		echo >> "$MESSAGE"
		# Skip the "total" line from ls
		ls -lt "$workdir" | tail -n +2 | head -n "$MAXFILES" >> "$MESSAGE"
	else
		cat <<EOF >> "$MESSAGE"
NOTICE: This is a very large number of files in a single directory,
and this may possibly cause slow job behavior.
EOF
	fi
}

#
# Write node usage (pestat) and process information (psjob) to the message
#
append_running_job_info() {
	cat <<EOF >> "$MESSAGE"

RAM-memory usage and CPU-load usage of your job on the job nodes.
-----------------------------------------------------------------

Please look at these usage numbers to determine why the job was behaving badly
(note especially items marked by *):

EOF
	"$PESTAT" -j "$jobid" >> "$MESSAGE" 2>&1
	cat <<EOF >> "$MESSAGE"

Explanation of some columns in the usage list:
Hostname: The compute node running your job.
Num_CPU Use/Tot: The number of CPU cores allocated to jobs / total in the node.
CPUload: The CPU load average (should not exceed the number of allocated CPU cores).
Memsize: Physical memory (MB) in the node.
Freemem: Free memory (MB) in the node (should not be close to zero).

Process information on the nodes of your job.
---------------------------------------------

Please look at these processes to determine why the job was behaving badly:

EOF
	echo -n "Process status..."
	"$PSJOB" "$jobid" >> "$MESSAGE" 2>&1
}

#
# Notify about (and possibly kill) one job.
# Returns non-zero if the job could not be processed.
#
process_job() {
	local jobid=$1
	local action_print

	if (( killjob )); then
		action_print="Your $CLUSTERNAME job id $jobid has been killed by the superuser."
	else
		action_print="Please contact ${ADMINMAIL}: your $CLUSTERNAME job id $jobid may have to be killed."
	fi

	# Check that the job exists and is not a job array with multiple jobs
	local squeue_state
	if ! squeue_state=$(squeue -h -O State -j "$jobid"); then
		echo "ERROR: Could not inquire about job $jobid"
		return 1
	fi
	if [[ -z "$squeue_state" ]]; then
		echo "ERROR: Job $jobid was not found in the queue"
		return 1
	fi
	if (( $(wc -l <<< "$squeue_state") > 1 )); then
		echo "ERROR: The job $jobid is a job array with multiple jobs. Please select only one of the array jobs:"
		squeue -O JobArrayID,ArrayJobID,ArrayTaskID,JobID,StartTime,TimeUsed,TimeLimit -j "$jobid"
		return 1
	fi

	echo -n "Get job information..."
	if ! scontrol --details show job "$jobid" > "$JOBMSGS" 2> "$JOBERRS" || [[ -s "$JOBERRS" ]]; then
		echo
		cat "$JOBERRS"
		return 1
	fi

	# Get the user name (UserId=name(uid)) and full name
	local userid fullname
	userid=$(job_field UserId)
	userid=${userid%%(*}
	if [[ -z "$userid" ]]; then
		echo "ERROR: Could not get userid of job $jobid"
		return 1
	fi
	fullname=$(getent passwd "$userid" | cut -d: -f5)

	cat <<EOF

Job $jobid belongs to user $userid, full name is $fullname
User groups: $(groups "$userid")
Action: ${action} a badly behaving job id $jobid
EOF

	#
	# Initialize message to the user
	#
	cat <<EOF > "$MESSAGE"

*** WARNING ***

${action_print}

Reason: ${action_reason}

If you have any questions about this action, please contact ${ADMINMAIL}.

You may want to consult the Niflheim Wiki page about batch job information:
$INFOURL

In the following we display various pieces of information about your badly behaving batch job.

Slurm batch system information about job id $jobid:
---------------------------------------------------

EOF
	cat "$JOBMSGS" >> "$MESSAGE"

	# Only print usage and process information for jobs that have started
	local jobstate
	jobstate=$(job_field JobState)
	echo "NOTE: This job has a state of $jobstate"
	if [[ "$jobstate" != "PENDING" ]]; then
		append_running_job_info
	fi

	local nodelist workdir
	nodelist=$(job_field NodeList)
	nodelist=${nodelist:-unknown}
	# WorkDir is taken from the rest of the line, since it may contain spaces
	workdir=$(sed -n 's/^[[:space:]]*WorkDir=//p' "$JOBMSGS" | head -n 1)
	echo -n "Listing files..."
	if [[ -n "$workdir" && -d "$workdir" ]]; then
		append_workdir_info "$workdir"
	else
		workdir=unknown
	fi
	echo "Done."

	#
	# Kill the job and log it
	#
	if (( killjob )); then
		echo "Now killing job $jobid"
		echo "Reason: $action_reason"
		if ! scancel "$jobid"; then
			echo "ERROR: scancel of job $jobid failed, no mail is sent"
			return 1
		fi
		echo "Adding entry to logfile $LOGFILE"
		echo "$(date +'%Y %b %e %T') $jobid $userid $workdir $nodelist $action_reason" >> "$LOGFILE"
	fi

	# Send mail to the user (the username is used as the local mail address)
	echo "Sending mail to user=$userid full name: $fullname"
	{ echo "Dear $fullname"; cat "$MESSAGE"; } |
		"$MAIL" -s "WARNING: ${action_print}" -b "$SUPERUSERMAIL" "$userid"
}

#
# Loop over the jobs given on the command line
#
status=0
for jobid in "$@"; do
	echo
	# A job id is a number, possibly as jobid_arraytaskid
	if ! [[ $jobid =~ ^[0-9]+(_[0-9]+)?$ ]]; then
		echo "ERROR: Job id $jobid must be a number or jobid_arraytaskid"
		status=1
		continue
	fi
	process_job "$jobid" || status=1
done
exit $status
