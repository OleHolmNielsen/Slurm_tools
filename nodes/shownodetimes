#!/usr/bin/env bash

# Print various Slurm Time and State fields for a node list
# ALL nodes are printed if no argument is given.
#
# Usage: shownodetimes [nodelist]
#
# Example: You may sort the output on increasing BootTime (column 2) by:
# shownodetimes [nodelist] | sort -k 2 -r

# Use default Slurm time format:
unset SLURM_TIME_FORMAT

scontrol --oneliner show node "$@" | awk '
BEGIN {
	# Heading
	printf("%-8s %-19s %-19s %-19s %-30s %-30s\n", "Nodename",
       		"BootTime", "SlurmdStartTime", "LastBusyTime", "Linux_kernel_name", "State")
}
{
	n = split($1,a,"=")
	if (a[1] == "NodeName" && n == 2)
		name = a[2]	# Get the NodeName
	else
		next		# Case of error output from scontrol
	# Process all fields in the line
	for (i=2; i<=NF; i++) {
		if (split($i,a,"=") == 2)
			node[a[1]] = a[2]
			# Detect the OS line "OS=Linux 4.18 ..." and use the kernel version (see man uname)
		if (a[1] == "OS")
			node[a[1]] = $(i+1)
	}
	printf("%-8s %-19s %-19s %-19s %-30s %-30s\n", name,
		node["BootTime"], node["SlurmdStartTime"], node["LastBusyTime"],
		node["OS"], node["State"])
}'
